# ===========================================
# Lavanderia do Bairro — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# ===========================================

# --- Banco de dados (Neon / PostgreSQL) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# --- Auth.js v5 ---
# Gere com: openssl rand -base64 32
AUTH_SECRET=""

# Google OAuth — console.cloud.google.com
# Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Resend — e-mails transacionais — resend.com/api-keys
AUTH_RESEND_KEY=""
RESEND_API_KEY=""

# --- Stripe (não usado na v1) ---
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"
STRIPE_PRICE_ID_PRO="price_placeholder"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
EMAIL_FROM="Lavanderia do Bairro <onboarding@resend.dev>"
